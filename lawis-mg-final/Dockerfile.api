# syntax=docker/dockerfile:1
FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr tesseract-ocr-fra tesseract-ocr-ara \
    poppler-utils libgl1 libglib2.0-0 curl gosu \
    && rm -rf /var/lib/apt/lists/*
ENV PIP_DEFAULT_TIMEOUT=120 PIP_RETRIES=5 HF_HOME=/app/.cache/huggingface
COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install torch --index-url https://download.pytorch.org/whl/cpu
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements.txt
# Pré-télécharge les modèles ML dans l'image : sans ça, le premier chat en
# production bloquerait 15-20 min sur un téléchargement à la volée (2,2 Go).
# huggingface_hub reprend un téléchargement interrompu plutôt que de repartir
# de zéro, donc la boucle de tentatives ne re-télécharge pas ce qui est déjà reçu.
RUN for i in 1 2 3 4 5; do \
        python -c "from sentence_transformers import SentenceTransformer, CrossEncoder; SentenceTransformer('intfloat/multilingual-e5-large'); CrossEncoder('cross-encoder/ms-marco-MiniLM-L-6-v2')" && break; \
        echo "Tentative $i échouée — nouvel essai dans 5s..."; sleep 5; \
    done
COPY . .
RUN mkdir -p data/raw data/processed data/uploads data/vector_stores logs \
    && groupadd -r lexia && useradd -r -g lexia -d /app lexia \
    && chown -R lexia:lexia /app \
    && chmod +x entrypoint.sh
ENTRYPOINT ["./entrypoint.sh"]
EXPOSE 8000

# Un seul worker : SQLite (choix par défaut, cf. .env.example) n'est pas conçu
# pour des écrivains concurrents. Passer à plusieurs workers nécessite d'abord
# de migrer vers PostgreSQL (DATABASE_URL, voir DEPLOYMENT.md).
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
