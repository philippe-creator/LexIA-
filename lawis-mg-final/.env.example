# ════════════════════════════════════════════════════════════
# LexIA Maroc — Configuration
# 1. cp .env.example .env
# 2. Remplir les valeurs OBLIGATOIRES
# ════════════════════════════════════════════════════════════

APP_NAME=LexIA Maroc
APP_VERSION=2.0.0
DEBUG=false
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# OBLIGATOIRE — générer : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_OBLIGATOIRE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=45

# ── Connexion Google (optionnel) ─────────────────────────────
# Client ID OAuth 2.0 créé sur https://console.cloud.google.com/apis/credentials
# (type "Application Web"). Laisser vide désactive le bouton "Se connecter
# avec Google" côté frontend et fait échouer POST /auth/google côté API.
GOOGLE_CLIENT_ID=

# ── OCR cloud (optionnel) ─────────────────────────────────────
# Clé API Google Cloud Vision (API Vision activée + clé restreinte à celle-ci
# sur https://console.cloud.google.com/apis/credentials). Laisser vide : les
# PDF scannés sont traités par Tesseract en local (plus lent, gratuit, sans
# dépendance externe). Bascule automatique sur Tesseract si Vision échoue
# (quota épuisé, clé désactivée...) — rien à changer le jour où ça arrive.
GOOGLE_VISION_API_KEY=

# ── Base de données ──────────────────────────────────────────
# PRODUCTION : utiliser PostgreSQL (recommandé)
#   DATABASE_URL=postgresql://lexia_user:MOT_DE_PASSE@localhost:5432/lexia_db
# DÉVELOPPEMENT : SQLite (simple mais pas concurrent)
DATABASE_URL=sqlite:///./data/lexia.db

# ── LLM — quatre fournisseurs supportés, un seul actif via LLM_PROVIDER ──────
# Valeurs possibles : openai | gemini | openrouter | groq
LLM_PROVIDER=groq
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# Groq — https://console.groq.com/keys (gratuit, inférence très rapide — recommandé)
GROQ_API_KEY=gsk_VOTRE_CLE_ICI
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MODELS=openai/gpt-oss-120b

# OpenAI — https://platform.openai.com/api-keys (payant à l'usage, fiable)
OPENAI_API_KEY=sk-proj-VOTRE_CLE_ICI
OPENAI_MODEL=gpt-4o-mini

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=VOTRE_CLE_ICI
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter — https://openrouter.ai/keys (modèles gratuits disponibles mais
# souvent rate-limités ; vérifier la liste à jour sur openrouter.ai/models?max_price=0)
OPENROUTER_API_KEY=sk-or-v1-VOTRE_CLE_ICI
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

EMBEDDING_MODEL=intfloat/multilingual-e5-large
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
VECTOR_STORE_PROVIDER=chroma
CHROMA_PERSIST_DIR=./data/vector_stores
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
UPLOADS_DIR=./data/uploads
LOGS_DIR=./logs
TOP_K_RETRIEVAL=5
TOP_K_RERANK=3
HYBRID_ALPHA=0.7
QUERY_EXPANSION_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_UPLOAD_SIZE_MB=50
WATCH_INTERVAL_HOURS=24
# Rattrapage historique de l'archive du Bulletin Officiel (~4891 numéros
# depuis 1912) — job séparé du cycle de veille normal ci-dessus, désactivé
# par défaut. Coûte du calcul continu (embedding) tant que l'archive n'est
# pas rattrapée : à activer volontairement sur un serveur dimensionné pour,
# jamais par défaut en local ni au premier déploiement.
SGG_BACKFILL_ENABLED=false
SGG_BACKFILL_BATCH_SIZE=5
SGG_BACKFILL_INTERVAL_HOURS=2
SGG_BASE_URL=https://www.sgg.gov.ma/BO.aspx
CNDP_BASE_URL=https://www.cndp.ma
DGI_BASE_URL=https://www.tax.gov.ma
CNSS_BASE_URL=https://www.cnss.ma
OMPIC_BASE_URL=https://www.ompic.ma
CSPJ_BASE_URL=https://juriscassation.cspj.ma
OPENDATA_API_URL=https://www.data.gov.ma/api/3

# ── Email (mot de passe oublié, notifications de veille) ─────
# Optionnel : si SMTP_HOST est vide, l'envoi d'email échoue silencieusement
# (log un avertissement) — le reste de l'app fonctionne quand même.
# Exemple Gmail : utiliser un mot de passe d'application (pas le mot de passe
# du compte) — https://myaccount.google.com/apppasswords
FRONTEND_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# ── OCR (pour PDF scannés) ───────────────────────────────────
# Linux :   sudo apt install tesseract-ocr tesseract-ocr-fra tesseract-ocr-ara
#           TESSERACT_CMD=tesseract
# Windows : https://github.com/UB-Mannheim/tesseract/wiki
#           TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# macOS :   brew install tesseract
#           TESSERACT_CMD=tesseract
TESSERACT_CMD=
